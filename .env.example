# Mars IT (NF-3043) Environment Variables

# 1. Render Managed PostgreSQL tashqi ulanish ssilkasi (Render Dashboard -> PostgreSQL -> External Database URL)
DATABASE_URL="postgres://mars_user:password@dpg-xxxxxx.oregon-postgres.render.com/mars_db?sslmode=require"

# 2. JWT tokenlar uchun 64-belgili maxfiy kalit
JWT_SECRET="mars-it-platform-super-secret-jwt-key-3043-secure-production-random-hash"

# 3. Boshlang'ich Admin paroli (birinchi marta baza ochilganda)
ADMIN_INITIAL_PASSWORD="admin123"

# 4. Cloudflare R2 Rasmlar Ombori (Ixtiyoriy: agar kiritilmasa, avtomatik lokal server omboriga yuklanadi)
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key"
# R2_SECRET_ACCESS_KEY="your-r2-secret-key"
# R2_BUCKET_NAME="mars-it-submissions"
# R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"
